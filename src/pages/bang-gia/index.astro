---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PriceTable from '../../components/PriceTable.astro';
import Faq from '../../components/Faq.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import ZaloButton from '../../components/ZaloButton.astro';
import { utmContent, agencyPricing, perPagePricing, otherLanguages, otherLanguagePricing, site } from '../../config/site';

function formatTier(v: number | 'thoathuan') {
  return v === 'thoathuan' ? 'Thoả thuận' : v.toLocaleString('vi-VN') + 'đ';
}

const startingPrice = perPagePricing[0].pricePerPage;
const otherLangStarting = otherLanguagePricing[0].pricePerPage;
// Cập nhật thủ công khi giá thay đổi — dùng cho tín hiệu freshness (LastUpdated + WebPage schema)
const pageUpdated = new Date('2026-07-21');

const faqItems = [
  {
    question: 'Giá rẻ vậy thì bản dịch có kém chất lượng không?',
    answer: 'Không. Phần rẻ hơn đến từ việc rút ngắn thời gian thao tác nhờ tự động hoá — bố cục, thuật ngữ có sẵn khuôn cho từng loại giấy tờ — chứ không phải bỏ bớt bước kiểm tra chéo trước khi đóng mộc.',
  },
  {
    question: 'Có dịch được ngôn ngữ khác ngoài tiếng Anh không?',
    answer: `Có — ${otherLanguages.join(', ')}... theo yêu cầu, từ ${otherLangStarting.toLocaleString('vi-VN')}đ/trang. Tiếng Anh vẫn là dịch vụ chính (khối lượng lớn nhất, quy trình tự động hoá sâu nhất nên giá thấp hơn); các ngôn ngữ khác chưa có cùng mức tự động hoá nên giá theo trang cao hơn. Gửi Zalo kèm ngôn ngữ cần dịch để nhận báo giá chính xác.`,
  },
  {
    question: 'Nên chọn gói trọn hồ sơ hay tính theo trang?',
    answer: 'Nếu dịch cả bộ hồ sơ (thường 20–30 trang) thì gói trọn hồ sơ rẻ hơn và biết trước tổng tiền. Chỉ cần dịch một, hai giấy tờ lẻ thì tính theo trang tiện hơn.',
  },
  {
    question: 'Hồ sơ dày hơn 30 trang thì sao?',
    answer: 'Phần vượt tính thêm 12.000đ/trang — con số này báo trước, không cộng dồn bất ngờ lúc giao hàng.',
  },
  {
    question: 'Công ty du lịch, đại lý gửi số lượng lớn có giá khác không?',
    answer: 'Có — xem bảng giá sỉ theo bậc ở trên, áp dụng từ 15 hồ sơ/tháng trở lên. Khối lượng càng lớn, giá/trang càng giảm. Từ 50 hồ sơ/tháng thoả thuận riêng theo nhu cầu.',
  },
  {
    question: 'Gói siêu gấp trong ngày có cộng thêm phí ngoài bảng không?',
    answer: 'Không. Mức giá siêu gấp trong bảng đã là giá cuối, không có phụ thu nào khác đi kèm.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Bảng Giá Dịch Thuật Visa',
    dateModified: pageUpdated.toISOString(),
    publisher: { '@type': 'Organization', name: site.name },
  },
];
---

<BaseLayout
  title="Bảng Giá Dịch Thuật Visa 2026 — Từ 20.000đ/Trang"
  description="Bảng giá dịch thuật hồ sơ visa: từ 20.000đ/trang hoặc trọn hồ sơ từ 400.000đ. Giá sỉ đại lý từ 17.000đ/trang cho đối tác từ 15 hồ sơ/tháng. Có mộc công ty, xác nhận dịch."
  path="/bang-gia/"
  schema={schema}
>
  <div class="container price-page">
    <Breadcrumb items={[{ label: 'Bảng giá', href: '/bang-gia/' }]} />
    <h1>Bảng Giá Dịch Thuật Visa</h1>
    <LastUpdated date={pageUpdated} />

    <div class="price-hero">
      <p class="price-hero__label">Giá khởi điểm</p>
      <p class="price-hero__value">{startingPrice.toLocaleString('vi-VN')}đ<span>/trang</span></p>
      <p class="price-hero__sub">
        Khảo sát giá công khai trên thị trường dịch thuật tiếng Anh cho hồ sơ visa tại TP.HCM (tháng 7/2026): đơn giá
        theo trang phổ biến 49.000–150.000đ/trang, gói dịch vụ visa du lịch trọn gói phổ biến 350.000–650.000đ/bộ —
        thường <strong>chưa gồm</strong> phí công chứng/in ấn, cộng thêm riêng. Giá niêm yết dưới đây là con số cuối
        cùng, đã gồm mộc công ty + xác nhận dịch, không phụ phí ẩn.
      </p>
    </div>

    <p class="text-muted">
      Hai cách tính: chọn <strong>gói trọn hồ sơ</strong> nếu dịch cả bộ (biết tổng tiền ngay từ đầu), hoặc tính{' '}
      <strong>theo trang</strong> nếu chỉ cần một vài giấy tờ lẻ. Giá thấp hơn mặt bằng chung nhờ tự động hoá phần
      thao tác lặp lại — mọi bản dịch vẫn có mộc công ty + xác nhận dịch như nhau.
    </p>

    <section class="cost-example">
      <h2>Dịch hồ sơ visa 25 trang giá bao nhiêu?</h2>
      <p>
        Hồ sơ 25 trang tính theo trang ở đây tốn {(startingPrice * 25).toLocaleString('vi-VN')}đ (
        {startingPrice.toLocaleString('vi-VN')}đ/trang), hoặc 400.000đ nếu chọn gói trọn hồ sơ — so với mặt bằng
        thị trường 1.225.000đ–3.750.000đ cho cùng số trang (49.000–150.000đ/trang, khảo sát công khai TP.HCM
        7/2026).
      </p>
      <div class="table-scroll">
        <table class="responsive-table">
          <thead>
            <tr>
              <th>Cách tính</th>
              <th>Đơn giá</th>
              <th>Tổng chi phí 25 trang</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-label="Cách tính">Mặt bằng thị trường (tính theo trang)</td>
              <td data-label="Đơn giá">49.000–150.000đ/trang</td>
              <td data-label="Tổng chi phí 25 trang">1.225.000đ–3.750.000đ*</td>
            </tr>
            <tr>
              <td data-label="Cách tính">Ở đây — tính theo trang</td>
              <td data-label="Đơn giá">{startingPrice.toLocaleString('vi-VN')}đ/trang</td>
              <td data-label="Tổng chi phí 25 trang">{(startingPrice * 25).toLocaleString('vi-VN')}đ</td>
            </tr>
            <tr>
              <td data-label="Cách tính">Ở đây — gói trọn hồ sơ (tới 30 trang)</td>
              <td data-label="Đơn giá">Trọn gói cố định</td>
              <td data-label="Tổng chi phí 25 trang">400.000đ</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="price-table__note">
        *Khoảng giá mặt bằng chung tổng hợp từ bảng giá công khai của một số đơn vị dịch thuật/công chứng tại
        TP.HCM, khảo sát tháng 7/2026 — không đại diện cho một đơn vị cụ thể nào, chỉ để tham khảo đối chiếu. Nhiều
        đơn vị tính thêm phí công chứng, in ấn, hoặc VAT riêng ngoài đơn giá dịch; giá của{' '}
        <strong>Dịch Thuật Visa 247</strong> đã gồm mộc công ty + xác nhận dịch, không phát sinh thêm khi giao.
      </p>
    </section>

    <img
      src="/img/so-do-2-cach-tinh-gia.webp"
      alt="So sánh gói trọn hồ sơ (biết trước tổng tiền, không phát sinh) và tính theo trang (linh hoạt theo số trang thực tế)"
      width={1400}
      height={560}
      class="price-compare-image"
      loading="eager"
    />

    <PriceTable />

    <section class="agency-pricing">
      <h2>Giá sỉ cho đại lý visa là bao nhiêu?</h2>
      <p>
        Đại lý, công ty du lịch, cộng tác viên gửi từ 15 hồ sơ/tháng trở lên được áp giá sỉ theo bậc: từ{' '}
        {formatTier(agencyPricing[0].perPagePrice)}/trang, giảm còn {formatTier(agencyPricing[1].perPagePrice)}/trang
        {' '}từ 30 hồ sơ/tháng — khác với giá lẻ {startingPrice.toLocaleString('vi-VN')}đ/trang ở trên.
      </p>
      <p class="agency-pricing__condition">Áp dụng từ 15 hồ sơ/tháng trở lên — khác với giá lẻ ở bảng trên</p>
      <div class="table-scroll">
        <table class="responsive-table">
          <thead>
            <tr>
              <th>Khối lượng/tháng</th>
              <th>Giá trọn hồ sơ</th>
              <th>Giá theo trang</th>
            </tr>
          </thead>
          <tbody>
            {
              agencyPricing.map((tier) => (
                <tr>
                  <td data-label="Khối lượng/tháng">{tier.volumeLabel}</td>
                  <td data-label="Giá trọn hồ sơ">{formatTier(tier.bundlePrice)}</td>
                  <td data-label="Giá theo trang">{formatTier(tier.perPagePrice)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="price-table__note">
        Giá sỉ dành riêng cho đại lý visa, công ty du lịch, cộng tác viên gửi khối lượng ổn định hằng tháng — không
        áp dụng cho khách lẻ. Xem thêm <a href="/agency/">SLA, công nợ và quy trình hợp tác đại lý</a>.
      </p>
      <ZaloButton utmContent={utmContent.agency} label="Liên hệ nhận báo giá đại lý" />
    </section>

    <section class="price-page__faq">
      <h2>Câu hỏi thường gặp</h2>
      <Faq items={faqItems} />
    </section>

    <div class="final-cta">
      <ZaloButton utmContent={utmContent.banggia} variant="block" />
    </div>
  </div>
</BaseLayout>

<style>
  .price-page {
    padding: var(--space-6) 0 var(--space-8);
    max-width: 760px;
  }

  .price-page > h1 {
    margin-top: var(--space-4);
  }

  .price-hero {
    background: var(--navy-900);
    color: var(--white);
    border-radius: var(--radius);
    padding: var(--space-6);
    margin: var(--space-5) 0 var(--space-6);
  }

  .price-hero__label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #b7c0d4;
    margin-bottom: var(--space-1);
  }

  .price-hero__value {
    font-size: clamp(2.25rem, 8vw, 3rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .price-hero__value span {
    font-size: 1.25rem;
    font-weight: 600;
    color: #b7c0d4;
  }

  .price-hero__sub {
    color: #d7dcea;
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  .price-compare-image {
    display: block;
    width: 100%;
    height: auto;
    margin: var(--space-5) 0 var(--space-6);
  }

  .agency-pricing {
    margin-top: var(--space-7);
    background: var(--white);
    border: 1px dashed var(--accent);
    border-radius: var(--radius);
    padding: var(--space-5);
  }

  .agency-pricing__condition {
    display: inline-block;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 14px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: var(--space-4);
  }

  .agency-pricing .responsive-table th,
  .agency-pricing .responsive-table td,
  .cost-example .responsive-table th,
  .cost-example .responsive-table td {
    text-align: left;
    padding: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .agency-pricing .responsive-table thead,
  .cost-example .responsive-table thead {
    background: var(--navy-900);
    color: var(--white);
  }

  .cost-example {
    margin-top: var(--space-7);
  }

  @media (max-width: 640px) {
    .agency-pricing .responsive-table thead,
    .cost-example .responsive-table thead {
      display: none;
    }

    .agency-pricing .responsive-table,
    .agency-pricing .responsive-table tbody,
    .agency-pricing .responsive-table tr,
    .agency-pricing .responsive-table td,
    .cost-example .responsive-table,
    .cost-example .responsive-table tbody,
    .cost-example .responsive-table tr,
    .cost-example .responsive-table td {
      display: block;
      width: 100%;
    }

    .agency-pricing .responsive-table tr,
    .cost-example .responsive-table tr {
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      margin-bottom: var(--space-3);
      background: var(--white);
    }

    .agency-pricing .responsive-table td,
    .cost-example .responsive-table td {
      border-bottom: none;
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .agency-pricing .responsive-table td::before,
    .cost-example .responsive-table td::before {
      content: attr(data-label);
      font-weight: 700;
      color: var(--navy-700);
    }
  }

  .price-table__note {
    font-size: 0.875rem;
    color: var(--navy-700);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .price-page__faq {
    margin-top: var(--space-7);
  }

  .final-cta {
    margin-top: var(--space-6);
    max-width: 420px;
  }
</style>
