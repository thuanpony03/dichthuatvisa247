---
import BaseLayout from '../layouts/BaseLayout.astro';
import ZaloButton from '../components/ZaloButton.astro';
import { utmContent } from '../config/site';
---

<BaseLayout
  title="Không Tìm Thấy Trang | Dịch Thuật Visa 247"
  description="Trang bạn tìm không tồn tại hoặc đã được di chuyển. Quay lại trang chủ hoặc xem bảng giá, thư viện mẫu dịch."
  path="/404/"
  noindex={true}
>
  <div class="container error-page">
    <p class="error-page__code">404</p>
    <h1>Không tìm thấy trang này</h1>
    <p class="error-page__desc">
      Trang bạn tìm không tồn tại, đã bị đổi tên, hoặc đường link bị gõ sai. Anh/chị có thể quay lại trang chủ hoặc
      chọn một trong các mục dưới đây.
    </p>
    <div class="error-page__links">
      <a href="/">Trang chủ</a>
      <a href="/bang-gia/">Bảng giá</a>
      <a href="/mau-dich/">Thư viện mẫu dịch</a>
      <a href="/lien-he/">Liên hệ</a>
    </div>
    <div class="error-page__cta">
      <ZaloButton utmContent={utmContent.cuoi} label="Cần dịch gấp? Nhắn Zalo ngay" />
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    padding: var(--space-8) var(--space-4);
    text-align: center;
    max-width: 560px;
  }

  .error-page__code {
    font-size: 4rem;
    font-weight: 800;
    color: var(--navy-900);
    margin: 0;
    line-height: 1;
  }

  .error-page__desc {
    color: var(--navy-700);
    margin: var(--space-4) 0 var(--space-6);
  }

  .error-page__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .error-page__links a {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    color: var(--navy-900);
    text-decoration: none;
    font-weight: 600;
    background: var(--white);
  }

  .error-page__links a:hover {
    border-color: var(--navy-900);
  }

  .error-page__cta {
    display: flex;
    justify-content: center;
  }
</style>
