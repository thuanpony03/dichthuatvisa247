import DownloadTemplateLayout from '../../../components/DownloadTemplateLayout.astro';

const faqItems = [
  {
    question: 'Mẫu song ngữ này có cần dịch thuật thêm không?',
    answer: 'Bản thân giấy ủy quyền song ngữ thì không — đó là lý do nên dùng bản song ngữ ngay từ đầu. Nhưng giấy khai sinh, CCCD, và các giấy tờ tiếng Việt nộp kèm trong hồ sơ visa của trẻ thì vẫn cần bản dịch có xác nhận của đơn vị dịch thuật.',
    link: '/mau-dich/giay-khai-sinh/',
    linkLabel: 'Xem mẫu dịch khai sinh',
  },
  {
    question: 'Ông bà đưa cháu đi du lịch Thái Lan/Singapore có cần giấy này không?',
    answer: 'Nên có. Kể cả nước miễn visa, hãng bay và cửa khẩu vẫn có quyền hỏi giấy chứng minh sự đồng ý của cha mẹ khi trẻ đi với người không phải cha mẹ.',
  },
  {
    question: 'Cha mẹ đã ly hôn, chỉ một người ký được không?',
    answer: 'Tuỳ nơi tiếp nhận. Người có quyền nuôi con theo bản án/quyết định ly hôn ký kèm bản sao quyết định đó thường được chấp nhận — mang theo giấy tờ này khi đi chứng thực và khi bay.',
  },
  {
    question: 'Giấy ủy quyền có thời hạn bao lâu?',
    answer: 'Ghi rõ thời hạn theo chuyến đi (mẫu có sẵn dòng này). Không nên lập ủy quyền vô thời hạn — nhiều nơi từ chối chứng thực và hải quan có thể nghi ngờ.',
  },
  {
    question: 'Tôi cần dịch giấy khai sinh và hộ khẩu kèm hồ sơ của bé, giá thế nào?',
    answer: '20.000đ/trang gói tiêu chuẩn 3–5 ngày, có gói gấp 24h; khai sinh + hộ khẩu/CT07 thường chỉ 2–4 trang.',
    link: '/bang-gia/',
    linkLabel: 'Xem bảng giá đầy đủ',
  },
];

const files = [
  {
    href: '/downloads/mau-giay-uy-quyen-dua-tre-em-di-nuoc-ngoai-song-ngu.docx',
    downloadName: 'uy-quyen-tre-em-docx',
    label: 'Tải bản Word (.docx) song ngữ',
  },
  {
    href: '/downloads/mau-giay-uy-quyen-dua-tre-em-di-nuoc-ngoai-song-ngu.pdf',
