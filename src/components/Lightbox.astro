---
// Lightbox JS thuần (không thư viện) — dùng <dialog> gốc của trình duyệt.
interface LightboxImage {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
}

interface Props {
  images: LightboxImage[];
  watermark?: boolean; // đóng watermark logo + tên miền, opacity ~15%, chéo góc (Mục 9.3)
  columns?: 1 | 3;
}

const { images, watermark = false, columns = 3 } = Astro.props;
---

<div class={`lightbox-grid lightbox-grid--cols-${columns}`}>
  {
    images.map((img, i) => (
      <button
        type="button"
        class="lightbox-grid__item"
        data-lightbox-trigger
        data-full={img.src}
        data-alt={img.alt}
        aria-label={`Phóng to: ${img.alt}`}
      >
        <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading={i === 0 ? 'eager' : 'lazy'} />
        {watermark && <span class="lightbox-grid__watermark" aria-hidden="true">dichthuatvisa247.com</span>}
        {img.caption && <span class="lightbox-grid__caption">{img.caption}</span>}
      </button>
    ))
  }
</div>

<dialog id="lightbox-dialog" class="lightbox-dialog">
  <button type="button" class="lightbox-dialog__close" data-lightbox-close aria-label="Đóng">✕</button>
  <img id="lightbox-dialog-img" src="" alt="" />
</dialog>

<script>
  const dialog = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;
  const dialogImg = document.getElementById('lightbox-dialog-img') as HTMLImageElement | null;

  if (dialog && dialogImg) {
    document.querySelectorAll('[data-lightbox-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const full = btn.getAttribute('data-full') || '';
        const alt = btn.getAttribute('data-alt') || '';
        dialogImg.src = full;
        dialogImg.alt = alt;
        dialog.showModal();
      });
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
  }
</script>

<style>
  .lightbox-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  .lightbox-grid--cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .lightbox-grid__item {
    position: relative;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--white);
    cursor: zoom-in;
    display: block;
  }

  .lightbox-grid__item img {
    width: 100%;
  }

  .lightbox-grid__watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-30deg);
    color: rgba(255, 255, 255, 0.6);
    font-weight: 700;
    font-size: 0.875rem;
    background: rgba(15, 27, 51, 0.15);
    pointer-events: none;
  }

  .lightbox-grid__caption {
    display: block;
    padding: var(--space-2);
    font-size: 0.8125rem;
    color: var(--navy-700);
    text-align: left;
  }

  .lightbox-dialog {
    border: none;
    border-radius: var(--radius);
    padding: 0;
    background: transparent;
    max-width: min(90vw, 800px);
    max-height: 90vh;
  }

  .lightbox-dialog::backdrop {
    background: rgba(15, 27, 51, 0.85);
  }

  .lightbox-dialog img {
    width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius);
  }

  .lightbox-dialog__close {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--white);
    border: none;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 640px) {
    .lightbox-grid--cols-3 {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2);
    }
  }
</style>
