---
// Dải minh hoạ đường bay — thay cho banner ảnh chụp/stock cũ. Vẽ tay bằng SVG hình khối phẳng
// (đường bay đứt nét + máy bay + mộc tròn đỏ), không dùng ảnh chụp/AI-generated để giữ đúng
// tinh thần "bằng chứng thật, không trang trí giả" đã thống nhất cho site.
interface Props {
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<div class="travel-band">
  <div class="container travel-band__inner">
    <div class="travel-band__text">
      <h2>{title}</h2>
      {sub && <p>{sub}</p>}
      <slot />
    </div>
    <svg class="travel-band__art" viewBox="0 0 420 220" aria-hidden="true">
      <path
        d="M20 170 C 120 190, 220 60, 400 40"
        fill="none"
        stroke="rgba(255,255,255,0.35)"
        stroke-width="2.5"
        stroke-dasharray="2 10"
        stroke-linecap="round"
      />
      <circle cx="70" cy="60" r="5" fill="rgba(255,255,255,0.25)" />
      <circle cx="140" cy="30" r="3.5" fill="rgba(255,255,255,0.2)" />
      <circle cx="330" cy="140" r="6" fill="rgba(255,255,255,0.2)" />
      <circle cx="380" cy="100" r="3.5" fill="rgba(255,255,255,0.25)" />
      <g transform="translate(370,32) rotate(28)">
        <path
          d="M0 0 L26 8 L4 12 L-2 24 L-6 12 L-26 8 Z"
          fill="var(--white)"
        />
      </g>
      <g transform="translate(50,155)">
        <circle r="22" fill="none" stroke="var(--seal)" stroke-width="2.5" opacity="0.9" />
        <path d="M-9 0 -2 8 12 -10" fill="none" stroke="var(--seal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9" />
      </g>
    </svg>
  </div>
</div>

<style>
  .travel-band {
    background: linear-gradient(120deg, var(--navy-900) 0%, var(--navy-700) 100%);
    color: var(--white);
    padding: var(--space-7) 0;
    overflow: hidden;
  }

  .travel-band__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: center;
  }

  .travel-band__text {
    text-align: center;
    max-width: 520px;
  }

  .travel-band__text h2 {
    color: var(--white);
    margin-bottom: var(--space-3);
  }

  .travel-band__text p {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-5);
  }

  .travel-band__art {
    width: 100%;
    max-width: 360px;
    height: auto;
  }

  @media (min-width: 860px) {
    .travel-band__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }

    .travel-band__text {
      text-align: left;
    }
  }
</style>
