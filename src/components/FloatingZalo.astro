---
// Bong bóng Zalo nổi góc dưới-phải — chỉ hiện trên desktop/tablet (≥768px).
// Trên mobile đã có StickyBar (thanh ngang dưới cùng) lo phần này rồi, tránh trùng lặp
// hai kiểu CTA nổi cùng lúc trên màn hình nhỏ.
// Có vòng pulse liên tục + tự mở chữ vài giây sau khi tải trang để chắc khách thấy được lời
// mời gọi, không chỉ trông chờ khách tự hover mới biết.
import { contact, utmContent } from '../config/site';

const zaloHref = `${contact.zaloUrl}?utm_source=web&utm_content=${utmContent.floatingBubble}`;
---

<a
  href={zaloHref}
  class="floating-zalo"
  id="floating-zalo"
  target="_blank"
  rel="noopener"
  aria-label="Nhắn Zalo — báo giá ngay"
>
  <span class="floating-zalo__ring" aria-hidden="true"></span>
  <span class="floating-zalo__icon" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
      <path
        d="M12 3.5c-5 0-9 3.36-9 7.5 0 2.4 1.34 4.54 3.44 5.93-.15.9-.56 2.06-1.44 3.07 0 0 1.94-.2 3.7-1.63.98.32 2.06.5 3.3.5 5 0 9-3.36 9-7.87s-4-7.5-9-7.5Z"
        fill="currentColor"
      />
    </svg>
  </span>
  <span class="floating-zalo__label">Nhắn Zalo — báo giá ngay</span>
</a>

<script>
  const bubble = document.getElementById('floating-zalo');
  if (bubble) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const openDelay = reduceMotion ? 800 : 1600;
    const openDuration = 4500;
    const t1 = setTimeout(() => bubble.classList.add('is-peeking'), openDelay);
    const t2 = setTimeout(() => bubble.classList.remove('is-peeking'), openDelay + openDuration);
    bubble.addEventListener('mouseenter', () => {
      clearTimeout(t1);
      clearTimeout(t2);
    });
  }
</script>

<style>
  .floating-zalo {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 45;
    display: none;
    align-items: center;
    gap: var(--space-2);
    background: var(--zalo);
    color: var(--white);
    text-decoration: none;
    border-radius: 999px;
    height: 60px;
    width: 60px;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 104, 255, 0.4);
    transition: width 0.35s ease, box-shadow var(--transition-fast);
    white-space: nowrap;
  }

  .floating-zalo:hover,
  .floating-zalo:focus-visible,
  .floating-zalo.is-peeking {
    width: 288px;
    box-shadow: 0 10px 28px rgba(0, 104, 255, 0.5);
  }

  .floating-zalo__ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 2px solid var(--zalo);
    animation: zalo-pulse 2.2s ease-out infinite;
    pointer-events: none;
  }

  .floating-zalo:hover .floating-zalo__ring,
  .floating-zalo.is-peeking .floating-zalo__ring {
    display: none;
  }

  @keyframes zalo-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  .floating-zalo__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .floating-zalo__label {
    font-size: 0.9375rem;
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.2s ease;
    padding-right: var(--space-4);
  }

  .floating-zalo:hover .floating-zalo__label,
  .floating-zalo:focus-visible .floating-zalo__label,
  .floating-zalo.is-peeking .floating-zalo__label {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .floating-zalo {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-zalo {
      transition: none;
    }
    .floating-zalo__label {
      transition: none;
    }
    .floating-zalo__ring {
      animation: none;
      display: none;
    }
  }
</style>
