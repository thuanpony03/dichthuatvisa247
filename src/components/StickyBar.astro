---
// Sticky bar chỉ mobile, hiện sau khi cuộn quá 60% Khối 1 (Hero).
// Có <div id="sticky-trigger"></div> ở mốc 60% chiều cao Hero (dùng cho /lp/*) thì dùng IntersectionObserver;
// không có thì tự hiện sau khi cuộn quá 60% chiều cao màn hình (dùng cho các trang chính qua BaseLayout).
import { contact } from '../config/site';

interface Props {
  utmContent: string;
}

const { utmContent } = Astro.props;
const zaloHref = `${contact.zaloUrl}?utm_source=web&utm_content=${utmContent}`;
---

<div class="sticky-bar" id="sticky-bar">
  <a href={zaloHref} class="sticky-bar__btn sticky-bar__btn--zalo" target="_blank" rel="noopener">
    Nhắn Zalo
  </a>
  <a href={`tel:${contact.phoneTel}`} class="sticky-bar__btn sticky-bar__btn--call">Gọi ngay</a>
</div>

<script>
  const bar = document.getElementById('sticky-bar');
  const trigger = document.getElementById('sticky-trigger');

  if (bar && trigger && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle('is-visible', !entry.isIntersecting && entry.boundingClientRect.top < 0);
      },
      { threshold: 0 }
    );
    observer.observe(trigger);
  } else if (bar) {
    const onScroll = () => {
      bar.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.6);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .sticky-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    height: 56px;
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -2px 12px rgba(15, 27, 51, 0.15);
    transform: translateY(100%);
    transition: transform var(--transition-fast);
  }

  .sticky-bar.is-visible {
    transform: translateY(0);
  }

  .sticky-bar__btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .sticky-bar__btn--zalo {
    background: var(--zalo);
    color: var(--white);
  }

  .sticky-bar__btn--call {
    background: var(--navy-900);
    color: var(--white);
  }

  @media (min-width: 768px) {
    .sticky-bar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-bar {
      transition: none;
    }
  }
</style>
